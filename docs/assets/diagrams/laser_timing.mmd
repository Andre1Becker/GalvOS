%%{init: {"theme": "dark", "flowchart": {"curve": "linear"}}}%%
flowchart TD
    subgraph HOLDON["Blank -&gt; Lit: LASER_ON_HOLD_TICKS = 2 (src/output/galvo_out.cpp)"]
        direction TD
        A0["Tick -1<br/><small>blank jump ends,<br/>DAC arrives at target</small>"] --> A1["Tick 0<br/><small>rgbWrite() fires;<br/>DAC HELD at destination<br/>(hold armed)</small>"]
        A1 --> A2["Tick 1<br/><small>hold 1/2 -<br/>LEDC turn-on latency<br/>(up to 40us)</small>"]
        A2 --> A3["Tick 2<br/><small>hold 2/2 -<br/>mirror + LEDC settled</small>"]
        A3 --> A4["Tick 3<br/><small>first real lit<br/>point emitted</small>"]
    end

    subgraph HOLDOFF["Lit -&gt; Blank: LASER_OFF_HOLD_TICKS = 2 (symmetric)"]
        direction TD
        B0["Last lit tick"] --> B1["Tick 0<br/><small>rgbOff() fires;<br/>DAC HELD at last<br/>lit position (hold armed)</small>"]
        B1 --> B2["Tick 1<br/><small>hold 1/2 -<br/>LEDC turn-off latency</small>"]
        B2 --> B3["Tick 2<br/><small>hold 2/2</small>"]
        B3 --> B4["Tick 3<br/><small>DAC resumes moving<br/>toward blank target</small>"]
    end

    A4 -.->|same output tick stream| B0
    B4 -.->|same blank jump, Stage 8 shaping| Z0

    subgraph ZV["Stage 8 - ZV Input Shaping on a blank jump"]
        direction TD
        Z0["unshaped[i]<br/><small>Stage 5 S-curve<br/>trajectory</small>"]
        Z1["Impulse 1 @ t=0<br/><small>A1 = 1 / (1+K)</small>"]
        Z2["Impulse 2 @ t=td<br/><small>A2 = K / (1+K)</small>"]
        Z0 --> Z1
        Z0 --> Z2
        Z1 --> Z3
        Z2 --> Z3
        Z3["shaped[i] = A1*unshaped[i] + A2*unshaped[i-shift_pts]<br/><small>mechanical responses cancel -<br/>no residual vibration at landing</small>"]
    end

    ZK["K = exp( -zeta*pi / sqrt(1-zeta^2) )<br/>td = pi / (omega_n * sqrt(1-zeta^2)) = 1 / (2 * ring_freq_hz)<br/>shift_pts = round(td / tick_period)"]
    Z3 -.-> ZK

    classDef tick fill:#12121c,stroke:#00e5ff,stroke-width:1.5px,color:#e6e6f0
    classDef zv fill:#1a1a2e,stroke:#ff2ecb,stroke-width:2px,color:#ff2ecb
    classDef note fill:#0d0d14,stroke:#666,stroke-width:1px,color:#aaa,font-style:italic
    class A0,A1,A2,A3,A4,B0,B1,B2,B3,B4 tick
    class Z0,Z1,Z2,Z3 zv
    class ZK note
