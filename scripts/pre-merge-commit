#!/usr/bin/env bash
# .git/hooks/pre-merge-commit
# Runs before every merge commit. Requires --no-ff so a merge commit is actually
# created (fast-forward merges do NOT fire this hook).
#
# Firmware changes -> pio test -e native   (the three CONTRACT invariants)
# Python changes   -> pytest scripts/tests/
# Both             -> run both
#
# Any red result aborts the merge.

set -euo pipefail

# Files changed on the branch being merged, relative to the merge base.
CHANGED="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || git diff --name-only --cached)"

need_pio=0
need_py=0

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    src/*|include/*|lib/*|platformio.ini)          need_pio=1 ;;
    scripts/*.py|scripts/tests/*)                  need_py=1  ;;
  esac
done <<< "$CHANGED"

if [ "$need_pio" -eq 0 ] && [ "$need_py" -eq 0 ]; then
  echo "pre-merge-commit: no firmware/python changes, skipping tests"
  exit 0
fi

fail=0

if [ "$need_pio" -eq 1 ]; then
  echo "pre-merge-commit: pio test -e native"
  if ! pio test -e native; then
    echo "  native tests FAILED — merge aborted" >&2
    fail=1
  fi
fi

if [ "$need_py" -eq 1 ]; then
  echo "pre-merge-commit: pytest scripts/tests/"
  if ! python -m pytest scripts/tests/ -q; then
    echo "  python tests FAILED — merge aborted" >&2
    fail=1
  fi
fi

exit "$fail"
