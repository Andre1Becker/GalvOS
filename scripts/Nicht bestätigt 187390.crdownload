; native-env-snippet.ini
; Append to platformio.ini. Host build for the CONTRACT invariant tests.
; Compiles point_optimizer.cpp + shims against Unity, no ESP32 toolchain.
; Run: pio test -e native

[env:native]
platform = native
test_framework = unity
build_flags =
    -std=gnu++17
    -DUNIT_TEST
    -DNATIVE_BUILD
    -I include
    -I src
; Keep the host build minimal — only pull the files under test plus their shims.
; Adjust build_src_filter to the actual sources each test needs.
build_src_filter =
    +<patterns/point_optimizer.cpp>
    +<../test/shims/>
